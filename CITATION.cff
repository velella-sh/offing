    given-names: Armin
    website: "https://github.com/arminazimi"
repository-code: "https://github.com/velella-sh/offing"
url: "https://velella.sh/offing/"
license: Apache-2.0
version: 0.1.1
date-released: "2026-11-12"
keywords:
  - end-of-life
  - deprecation
  - software lifecycle
  - dependency management
  - software composition analysis
