{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/autopilot-run.v1.schema.json",
  "title": "Offing Autopilot run v1",
  "description": "The ordered phases of an Autopilot run and its selected findings and local worktree, when present.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "state", "transitions"],
  "properties": {
    "schemaVersion": { "const": "offing.autopilot-run.v1" },
    "mode": { "enum": ["dry-run", "prepare"] },
    "state": { "$ref": "#/$defs/state", "description": "The last recorded phase." },
    "transitions": {
      "description": "Phases in the order entered, starting with scan. Repeated visits are preserved.",
      "type": "array",
      "minItems": 1,
      "prefixItems": [{ "const": "scan" }],
      "items": { "$ref": "#/$defs/state" }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "findingIds"],
      "properties": {
        "wave": { "type": ["integer", "null"], "minimum": 0 },
        "findingIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "version"],
          "properties": {
            "runtime": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "branch", "baseCommit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9]{6}$" },
        "branch": { "type": "string", "pattern": "^offing/autopilot/[A-Za-z0-9]{6}$" },
        "baseCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
      }
    },
    "stopReason": { "type": "string", "minLength": 1 },
    "replay": {
      "description": "Local replay checkpoint and observable progress.",
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "context", "usage", "elapsedMs", "tests", "turn", "resume"],
      "properties": {
        "head": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
        "context": { "$ref": "#/$defs/digest" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turns", "tokens", "costCents"],
          "properties": {
            "turns": { "$ref": "#/$defs/count" },
            "tokens": { "$ref": "#/$defs/count" },
            "costCents": { "$ref": "#/$defs/count" }
          }
        },
        "elapsedMs": { "$ref": "#/$defs/count" },
        "tests": { "enum": ["pending", "passed", "failed", "unavailable"] },
        "turn": { "$ref": "#/$defs/count" },
        "resume": { "$ref": "#/$defs/count" },
        "previous": { "$ref": "#/$defs/digest" },
        "remaining": { "$ref": "#/$defs/count" },
        "introduced": { "$ref": "#/$defs/count" }
      }
    }
  },
  "if": { "properties": { "state": { "const": "stopped" } } },
  "then": { "required": ["stopReason"] },
  "else": { "not": { "required": ["stopReason"] } },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": {
      "enum": ["scan", "plan", "baseline-tests", "codemods", "agent-turn", "tests", "verify", "done", "stopped"]
    }
  }
}
