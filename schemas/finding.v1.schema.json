{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/finding.v1.schema.json",
  "title": "Offing finding v1",
  "description": "One evidence-backed lifecycle finding, as returned by explain_deprecation and exposed as an offing://findings resource. It is the item schema of the findings array in scan.v1.",
  "type": "object",
  "required": [
    "id",
    "ruleId",
    "detector",
    "title",
    "summary",
    "severity",
    "location",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "ruleId": {
      "type": "string"
    },
    "detector": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "enum": [
        "exact",
        "range",
        "inferred-from-lock"
      ]
    },
    "location": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "replacement": {
      "type": "string"
    },
    "dependencyPath": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessedAt": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "advisoryIds": {
      "type": "array",
      "description": "OSV advisory identifiers with no fixed version for this finding's package, from the bundled OSV cross-reference.",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "usages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "language",
          "symbol",
          "location",
          "excerpt"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "import",
              "call",
              "config-key",
              "symbol"
            ]
          },
          "language": {
            "enum": [
              "javascript",
              "typescript",
              "python",
              "ruby",
              "json",
              "yaml",
              "toml",
              "ini",
              "php",
              "swift",
              "dart"
            ]
          },
          "symbol": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "required": [
        "usageCount",
        "affectedFiles",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "usageCount": {
          "type": "integer",
          "minimum": 0
        },
        "affectedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "constraints",
        "steps",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "instructions",
              "targets"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "instructions": {
                "type": "string",
                "minLength": 1
              },
              "targets": {
                "enum": [
                  "declaration",
                  "usages",
                  "all"
                ]
              }
            }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "command",
              "purpose"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "more": {
      "type": "object",
      "required": ["truncated", "hint", "omitted", "estimatedTokens"],
      "additionalProperties": false,
      "properties": {
        "truncated": { "const": true, "description": "Always true: the answer was cut to fit the size cap." },
        "hint": { "type": "string", "minLength": 1, "description": "How to read what was left out." },
        "omitted": {
          "type": "array",
          "description": "One entry per array that lost elements. A path with [] sums every array at that position, including those inside elements that were left out.",
          "items": {
            "type": "object",
            "required": ["path", "shown", "total"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*$",
                "description": "Where the array sits, such as findings or findings[].usages."
              },
              "shown": { "type": "integer", "minimum": 0, "description": "Elements in the answer as returned." },
              "total": { "type": "integer", "minimum": 1, "description": "Elements in the full answer." }
            }
          }
        },
        "clipped": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path of every text that was shortened; it ends with a truncation marker."
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the answer as returned: three characters of JSON text count as one token."
        }
      }
    }
  }
}
