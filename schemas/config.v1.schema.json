{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/config.v1.schema.json",
  "title": "Offing configuration v1",
  "description": "Configuration loaded from .offing.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for editor validation and autocompletion."
    },
    "schemaVersion": {
      "type": "string",
      "const": "offing.config.v1",
      "description": "Offing configuration schema version."
    },
    "failOn": {
      "enum": [
        "none",
        "info",
        "low",
        "medium",
        "high",
        "critical",
        null
      ],
      "description": "Exit with code 1 when a finding is at or above this severity."
    },
    "fail-on": {
      "enum": [
        "none",
        "info",
        "low",
        "medium",
        "high",
        "critical",
        null
      ],
      "description": "Alias for failOn."
    },
    "ignore": {
      "description": "Paths or glob patterns to ignore during scan.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "ignorePaths": {
      "description": "Deprecated alias. Use ignore.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "deprecated": true
    },
    "ignore-paths": {
      "description": "Deprecated alias. Use ignore.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "deprecated": true
    },
    "dataVersion": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pinned lifecycle data version, for example 2026.10.01, or 'bundled'.",
      "pattern": "\\S"
    },
    "data-version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Alias for dataVersion.",
      "pattern": "\\S"
    },
    "baseline": {
      "description": "Path or paths to baseline files to suppress known findings.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "baselines": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Alias for baseline.",
      "pattern": "\\S"
    },
    "baselineFiles": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Alias for baseline.",
      "pattern": "\\S"
    },
    "baseline-files": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Alias for baseline.",
      "pattern": "\\S"
    },
    "policy": {
      "type": "object",
      "description": "Named gates over lifecycle findings and their ordered, expiring exceptions.",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "minProperties": 2,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "days-left": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3650
              },
              "after-eol": {
                "type": "boolean"
              },
              "severity": {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "ecosystem": {
                "type": "string",
                "pattern": "\\S",
                "description": "Detector id or rule-id prefix to match."
              },
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "Repository-relative path or ignore-style glob."
              }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "expires"
            ],
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ecosystem"
                ]
              }
            ],
            "properties": {
              "ecosystem": {
                "type": "string",
                "pattern": "\\S",
                "description": "Detector id or rule-id prefix to match."
              },
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "Repository-relative path or ignore-style glob."
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "expires": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "owner": {
                "type": "string",
                "pattern": "\\S",
                "description": "Owner responsible for the exception."
              }
            }
          }
        }
      }
    },
    "extends": {
      "type": "string",
      "pattern": "\\S",
      "description": "Organization fleet policy path or explicit GitHub/GitLab policy reference."
    }
  }
}
