{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/config.v1.schema.json",
  "title": "Offing configuration v1",
  "description": "Configuration loaded from .offing.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for editor validation and autocompletion."
    },
    "schemaVersion": {
      "type": "string",
      "const": "offing.config.v1",
      "description": "Offing configuration schema version."
    },
    "failOn": {
      "enum": [
        "none",
        "info",
        "low",
        "medium",
        "high",
        "critical",
        null
      ],
      "description": "Exit with code 1 when a finding is at or above this severity."
    },
    "fail-on": {
      "enum": [
        "none",
        "info",
        "low",
        "medium",
        "high",
        "critical",
        null
      ],
      "description": "Alias for failOn."
    },
    "ignore": {
      "description": "Paths or glob patterns to ignore during scan.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "ignorePaths": {
      "description": "Deprecated alias. Use ignore.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "deprecated": true
    },
    "ignore-paths": {
      "description": "Deprecated alias. Use ignore.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "deprecated": true
    },
    "dataVersion": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pinned lifecycle data version, for example 2026.10.01, or 'bundled'.",
      "pattern": "\\S"
    },
    "data-version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Alias for dataVersion.",
      "pattern": "\\S"
    },
    "baseline": {
      "description": "Path or paths to baseline files to suppress known findings.",
      "type": [
        "string",
        "array",
        "null"
      ],
      "pattern": "\\S",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "baselines": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Alias for baseline.",
      "pattern": "\\S"
    },
    "baselineFiles": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Alias for baseline.",
      "pattern": "\\S"
    },
    "baseline-files": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Alias for baseline.",
      "pattern": "\\S"
    },
    "policy": {
      "type": "object",
      "description": "Named gates over lifecycle findings and their ordered, expiring exceptions.",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "minProperties": 2,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "days-left": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3650
              },
              "after-eol": {
                "type": "boolean"
              },
              "severity": {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "ecosystem": {
                "type": "string",
                "pattern": "\\S",
                "description": "Detector id or rule-id prefix to match."
              },
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "Repository-relative path or ignore-style glob."
              }
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "expires"
            ],
            "anyOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "ecosystem"
                ]
              }
            ],
            "properties": {
              "ecosystem": {
                "type": "string",
                "pattern": "\\S",
                "description": "Detector id or rule-id prefix to match."
              },
              "path": {
                "type": "string",
                "pattern": "\\S",
                "description": "Repository-relative path or ignore-style glob."
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "expires": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "owner": {
                "type": "string",
                "pattern": "\\S",
                "description": "Owner responsible for the exception."
              }
            }
          }
        }
      }
    },
    "extends": {
      "type": "string",
      "pattern": "\\S",
      "description": "Organization fleet policy path or explicit GitHub/GitLab policy reference."
    },
    "autopilot": {
      "type": "object",
      "description": "Limits for an explicitly requested Autopilot run. Reading config alone starts no processes.",
      "additionalProperties": false,
      "properties": {
        "testRuntime": {
          "const": "container",
          "description": "Use the pinned container by default when explicitly requesting test-only execution."
        },
        "driver": {
          "enum": ["replay", "command", "claude", "codex", "gemini", "aider"],
          "default": "replay"
        },
        "budget": {
          "type": "object",
          "default": {},
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "object",
              "default": {},
              "additionalProperties": false,
              "properties": {
                "wallTimeMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647,
                  "default": 300000
                },
                "turns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "default": 3
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000,
                  "default": 30000
                },
                "costCents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 100
                }
              }
            },
            "turn": {
              "type": "object",
              "default": {},
              "additionalProperties": false,
              "properties": {
                "wallTimeMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647,
                  "default": 120000
                },
                "turns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000,
                  "default": 1
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000,
                  "default": 10000
                },
                "costCents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000,
                  "default": 50
                }
              }
            }
          }
        },
        "allowedPaths": {
          "description": "Exact repository-relative file paths. If omitted, scope comes from the migration packets and the selected tests.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?=.*\\S)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/:\\u0000-\\u001f\\\\]+(?:/[^/:\\u0000-\\u001f\\\\]+)*(?![\\s\\S])"
          }
        },
        "deniedPaths": {
          "description": "Additional exact repository-relative file paths to deny. Built-in refusals always apply.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?=.*\\S)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/:\\u0000-\\u001f\\\\]+(?:/[^/:\\u0000-\\u001f\\\\]+)*(?![\\s\\S])"
          },
          "default": []
        },
        "tests": {
          "description": "Candidate test commands as argv. The execution caller must approve commands separately.",
          "type": "array",
          "default": [],
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000]*(?![\\s\\S])"
            }
          }
        },
        "secretEnv": {
          "description": "Names of additional environment values to redact, never to forward as credentials.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
          }
        }
      }
    }
  }
}
