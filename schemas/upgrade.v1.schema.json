{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/upgrade.v1.schema.json",
  "title": "Offing upgrade report v1",
  "description": "Whether a repository can move to a target runtime, answered from files already in the repository.",
  "type": "object",
  "required": ["schemaVersion", "target", "verdict", "analyzers", "issues"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "offing.upgrade.v1" },
    "target": {
      "type": "object",
      "required": ["runtime", "version"],
      "additionalProperties": false,
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": {
      "enum": ["ready", "blocked", "unknown"],
      "description": "blocked when any blocker; unknown when no analyzer applied; ready otherwise. unknown is not a statement that the upgrade is safe."
    },
    "analyzers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Ids of the analyzers that applied to this repository and target, sorted."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["analyzer", "level", "subject", "path", "reason", "evidence"],
        "additionalProperties": false,
        "properties": {
          "analyzer": { "type": "string", "minLength": 1 },
          "level": {
            "enum": ["blocker", "warning", "unknown"],
            "description": "blocker: will not install or run on the target. warning: works but is deprecated there. unknown: the evidence needed is missing."
          },
          "subject": { "type": "string", "minLength": 1 },
          "chain": { "$ref": "#/$defs/chain" },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "object",
            "required": ["kind", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["lockfile", "manifest", "rule"] },
              "value": { "type": "string", "minLength": 1, "description": "The exact value as written in the file, or a lifecycle rule id." }
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "description": "Confirmed blockers grouped by the shortest recorded path. Blockers without a recorded path remain ungrouped.",
      "required": ["total", "roots", "ungrouped"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dependency", "unlocks", "blockers"],
            "additionalProperties": false,
            "properties": {
              "dependency": { "type": "string", "minLength": 1 },
              "unlocks": { "type": "integer", "minimum": 1 },
              "blockers": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
            }
          }
        },
        "ungrouped": { "type": "array", "items": { "$ref": "#/$defs/blocker" } }
      }
    },
    "more": {
      "type": "object",
      "required": ["truncated", "hint", "omitted", "estimatedTokens"],
      "additionalProperties": false,
      "properties": {
        "truncated": { "const": true, "description": "Always true: the answer was cut to fit the size cap." },
        "hint": { "type": "string", "minLength": 1, "description": "How to read what was left out." },
        "omitted": {
          "type": "array",
          "description": "One entry per array that lost elements. A path with [] sums every array at that position, including those inside elements that were left out.",
          "items": {
            "type": "object",
            "required": ["path", "shown", "total"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*$",
                "description": "Where the array sits, such as findings or findings[].usages."
              },
              "shown": { "type": "integer", "minimum": 0, "description": "Elements in the answer as returned." },
              "total": { "type": "integer", "minimum": 1, "description": "Elements in the full answer." }
            }
          }
        },
        "clipped": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path of every text that was shortened; it ends with a truncation marker."
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the answer as returned: three characters of JSON text count as one token."
        }
      }
    }
  },
  "$defs": {
    "chain": {
      "type": "array",
      "minItems": 1,
      "description": "Locked package identities from a direct dependency through the issue package.",
      "items": { "type": "string", "minLength": 1 }
    },
    "blocker": {
      "type": "object",
      "required": ["subject", "path", "firstSupported"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "chain": { "$ref": "#/$defs/chain" },
        "firstSupported": {
          "type": "string",
          "minLength": 1,
          "description": "First package release supporting the target, or unknown when published evidence is unavailable."
        }
      }
    }
  }
}
