{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/fleet.v1.schema.json",
  "title": "Offing fleet result v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "offing.fleet.v1"
    },
    "repositories": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "integer",
      "minimum": 0
    },
    "severities": {
      "$ref": "#/$defs/counts"
    },
    "byProduct": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "byOwner": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "byRepository": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "deadlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deadline"
      }
    },
    "imageLineage": {
      "description": "Optional lineage document governed by lineage.v1.schema.json.",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "offing.lineage.v1"
        },
        "chains": {
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "chains"
      ],
      "additionalProperties": false
    },
    "repositoryStatus": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/status"
      }
    },
    "forecastAsOf": {
      "$ref": "#/$defs/forecastDay"
    }
  },
  "required": [
    "schemaVersion",
    "repositories",
    "findings",
    "severities",
    "byProduct",
    "byOwner",
    "byRepository",
    "deadlines",
    "repositoryStatus"
  ],
  "additionalProperties": false,
  "$defs": {
    "counts": {
      "type": "object",
      "properties": {
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "severities": {
          "$ref": "#/$defs/counts"
        }
      },
      "required": [
        "name",
        "findings",
        "repositories",
        "severities"
      ],
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "severities": {
          "$ref": "#/$defs/counts"
        },
        "nearestDeadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "required": [
        "name",
        "findings",
        "severities",
        "deadlines"
      ],
      "additionalProperties": false
    },
    "deadline": {
      "type": "object",
      "properties": {
        "deadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "deadline",
        "findings",
        "repositories"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "defaultBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "status": {
          "enum": [
            "scanned",
            "cached",
            "skipped",
            "failed"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "forecastEvidence": {
          "$ref": "#/$defs/forecastEvidence"
        },
        "campaignEvidence": {
          "$ref": "#/$defs/campaignEvidence"
        },
        "compliance": {
          "$ref": "#/$defs/compliance"
        },
        "whatIfEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "targets"
          ],
          "properties": {
            "date": {
              "$ref": "#/$defs/forecastDay"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runtime",
                  "version",
                  "verdict",
                  "reason"
                ],
                "properties": {
                  "runtime": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verdict": {
                    "enum": [
                      "ready",
                      "blocked",
                      "unknown"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "maxItems": 8
            }
          }
        }
      },
      "required": [
        "name",
        "host",
        "defaultBranch",
        "commit",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "campaignEvidence": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "#/$defs/forecastDay"
        },
        "runtimePins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runtime": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$" }
            },
            "required": ["runtime", "version"],
            "additionalProperties": false
          }
        },
        "codemods": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["setup", "install", "build", "test"] },
              "command": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
            },
            "required": ["kind", "command"],
            "additionalProperties": false
          }
        }
      },
      "required": ["date", "runtimePins", "codemods", "checks"],
      "additionalProperties": false
    },
    "forecastDay": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "forecastEvidence": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forecastObservation"
          }
        },
        "noData": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      },
      "required": [
        "findings",
        "noData"
      ],
      "additionalProperties": false
    },
    "forecastObservation": {
      "type": "object",
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/forecastLocation"
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "#/$defs/forecastDay"
            },
            {
              "type": "null"
            }
          ]
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "ruleId",
        "location",
        "deadline",
        "owners"
      ],
      "additionalProperties": false
    },
    "forecastLocation": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "jsonPointer": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "compliant",
            "violation",
            "invalid"
          ]
        },
        "policy": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "violations": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            "rule-threshold",
            "invalid-policy",
            "expired-exception",
            "unauthorized-override",
            null
          ]
        }
      },
      "required": [
        "status",
        "policy",
        "violations",
        "reason"
      ]
    }
  }
}
