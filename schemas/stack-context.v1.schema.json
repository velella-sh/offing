{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/stack-context.v1.schema.json",
  "title": "Offing stack context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "dataDate",
    "status",
    "components",
    "avoid",
    "omitted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "offing.stack-context.v1"
    },
    "asOf": {
      "$ref": "#/$defs/date"
    },
    "dataDate": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "known",
        "no-data"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "avoid": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/avoid"
      }
    },
    "omitted": {
      "type": "integer",
      "minimum": 0
    },
    "more": {
      "type": "object",
      "required": [
        "truncated",
        "hint",
        "omitted",
        "estimatedTokens"
      ],
      "additionalProperties": false,
      "properties": {
        "truncated": {
          "const": true,
          "description": "Always true: the answer was cut to fit the size cap."
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "description": "How to read what was left out."
        },
        "omitted": {
          "type": "array",
          "description": "One entry per array that lost elements. A path with [] sums every array at that position, including those inside elements that were left out.",
          "items": {
            "type": "object",
            "required": [
              "path",
              "shown",
              "total"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*$",
                "description": "Where the array sits, such as findings or findings[].usages."
              },
              "shown": {
                "type": "integer",
                "minimum": 0,
                "description": "Elements in the answer as returned."
              },
              "total": {
                "type": "integer",
                "minimum": 1,
                "description": "Elements in the full answer."
              }
            }
          }
        },
        "clipped": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Path of every text that was shortened; it ends with a truncation marker."
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the answer as returned: three characters of JSON text count as one token."
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "endOfLife",
        "ruleId",
        "source"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "endOfLife": {
          "$ref": "#/$defs/date"
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "component",
        "inUse",
        "status",
        "endOfLife",
        "ruleId",
        "source",
        "supportedVersions"
      ],
      "properties": {
        "kind": {
          "const": "runtime"
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "inUse": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "known",
            "no-data"
          ]
        },
        "endOfLife": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "ruleId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "supportedVersions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      }
    },
    "avoid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "component",
        "ruleId",
        "replacement",
        "endOfLife",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "api",
            "package"
          ]
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "replacement": {
          "type": "string",
          "minLength": 1
        },
        "endOfLife": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
