{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/agent-run.v1.schema.json",
  "title": "Offing agent driver run",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "offing.agent-run.v1"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "blocked",
        "timed-out"
      ]
    },
    "summary": {
      "type": "string"
    },
    "filesTouched": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*[\\\\:\\u0000])(?!(?:.*/)?(?:\\.|\\.\\.|\\.[gG][iI][tT])(?:/|$))[^/]+(?:/[^/]+)*$"
      }
    },
    "turns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "costUsd"
      ],
      "additionalProperties": false
    },
    "driver": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "filesTouched",
    "turns",
    "usage",
    "driver"
  ],
  "additionalProperties": false
}
