{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/forecast-records.v1.schema.json",
  "title": "Offing browser forecast records v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": "offing.forecast-records.v1" },
    "records": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [{ "$ref": "#/$defs/summary" }],
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/timeBucket" },
          { "$ref": "#/$defs/finding" },
          { "$ref": "#/$defs/fileRead" },
          { "$ref": "#/$defs/noData" },
          { "$ref": "#/$defs/noSupportedDeclarations" },
          { "$ref": "#/$defs/downloadableFile" }
        ]
      },
      "allOf": [
        { "contains": { "$ref": "#/$defs/timeBucket" } },
        { "contains": { "$ref": "#/$defs/fileRead" } },
        { "contains": { "$ref": "#/$defs/downloadableFile" }, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "count": { "type": "integer", "minimum": 0 },
    "line": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "today", "until", "dataVersion", "weather", "checked", "affecting", "total"],
      "properties": {
        "kind": { "const": "summary" },
        "today": { "$ref": "#/$defs/date" },
        "until": { "$ref": "#/$defs/date" },
        "dataVersion": { "$ref": "#/$defs/text" },
        "weather": { "enum": ["clear", "cloudy", "storm"] },
        "checked": { "$ref": "#/$defs/count" },
        "affecting": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" }
      }
    },
    "timeBucket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to", "until", "label", "total", "affecting"],
      "properties": {
        "kind": { "const": "time-bucket" },
        "from": { "$ref": "#/$defs/count" },
        "to": { "type": "integer", "minimum": 1 },
        "until": { "$ref": "#/$defs/date" },
        "label": { "type": "string", "pattern": "^\\d+-\\d+ months$" },
        "total": { "$ref": "#/$defs/count" },
        "affecting": { "$ref": "#/$defs/count" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bucketUntil", "date", "ruleId", "ecosystem", "title", "severity", "source", "findings"],
      "properties": {
        "kind": { "const": "finding" },
        "bucketUntil": { "$ref": "#/$defs/date" },
        "date": { "$ref": "#/$defs/date" },
        "ruleId": { "$ref": "#/$defs/text" },
        "ecosystem": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "source": { "type": "string", "pattern": "^https://\\S+$" },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "path": { "type": "string" },
              "line": { "$ref": "#/$defs/line" }
            }
          }
        }
      }
    },
    "fileRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input"],
      "properties": {
        "kind": { "const": "file-read" },
        "input": { "enum": ["file", "paste"] },
        "path": { "$ref": "#/$defs/text" }
      },
      "if": { "properties": { "input": { "const": "file" } } },
      "then": { "required": ["path"] },
      "else": { "properties": { "path": false } }
    },
    "noData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "component", "reference", "reason", "location"],
      "properties": {
        "kind": { "const": "notice" },
        "code": { "const": "no-data" },
        "component": { "$ref": "#/$defs/text" },
        "reference": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": { "type": "string" },
            "line": { "$ref": "#/$defs/line" },
            "column": { "$ref": "#/$defs/line" }
          }
        }
      }
    },
    "noSupportedDeclarations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code"],
      "properties": {
        "kind": { "const": "notice" },
        "code": { "const": "no-supported-declarations" }
      }
    },
    "downloadableFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "mediaType", "content"],
      "properties": {
        "kind": { "const": "downloadable-file" },
        "name": { "const": "offing-forecast.ics" },
        "mediaType": { "const": "text/calendar;charset=utf-8" },
        "content": { "type": "string", "pattern": "^BEGIN:VCALENDAR\\r\\n" }
      }
    }
  }
}
