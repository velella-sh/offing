{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/offing/schemas/forecast.v1.schema.json",
  "title": "Offing forecast v1",
  "type": "object",
  "required": ["schemaVersion", "root", "today", "until", "months", "groups", "affecting", "total"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "ebb.forecast.v1" },
    "root": { "type": "string" },
    "today": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "until": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "months": { "type": "integer", "minimum": 1, "maximum": 36 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["month", "events"],
        "additionalProperties": false,
        "properties": {
          "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
          "events": {
            "type": "array",
            "items": { "$ref": "#/$defs/event" }
          }
        }
      }
    },
    "affecting": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "noData": {
      "description": "Components without local lifecycle coverage. Current producers always include this array.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detector", "component", "reference", "reason", "location"],
        "additionalProperties": false,
        "properties": {
          "detector": { "type": "string" },
          "component": { "type": "string" },
          "reference": { "type": "string" },
          "reason": { "type": "string" },
          "location": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "more": {
      "type": "object",
      "required": ["truncated", "hint", "omitted", "estimatedTokens"],
      "additionalProperties": false,
      "properties": {
        "truncated": { "const": true, "description": "Always true: the answer was cut to fit the size cap." },
        "hint": { "type": "string", "minLength": 1, "description": "How to read what was left out." },
        "omitted": {
          "type": "array",
          "description": "One entry per array that lost elements. A path with [] sums every array at that position, including those inside elements that were left out.",
          "items": {
            "type": "object",
            "required": ["path", "shown", "total"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*$",
                "description": "Where the array sits, such as findings or findings[].usages."
              },
              "shown": { "type": "integer", "minimum": 0, "description": "Elements in the answer as returned." },
              "total": { "type": "integer", "minimum": 1, "description": "Elements in the full answer." }
            }
          }
        },
        "clipped": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path of every text that was shortened; it ends with a truncation marker."
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the answer as returned: three characters of JSON text count as one token."
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["date", "ruleId", "ecosystem", "title", "severity", "source", "findings"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "format": "date" },
        "ruleId": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "source": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
