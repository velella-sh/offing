{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/doctor.v1.schema.json",
  "title": "Offing doctor result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "root", "context", "summary", "checks", "privacy"],
  "properties": {
    "schemaVersion": { "const": "offing.doctor.v1" },
    "root": { "type": "string" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "platform", "nodeVersion"],
      "properties": {
        "kind": { "enum": ["local", "github-actions", "gitlab-ci"] },
        "platform": { "type": "string" },
        "nodeVersion": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "passed", "warnings", "failed"],
      "properties": {
        "status": { "enum": ["ready", "ready-with-warnings", "not-ready"] },
        "passed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "summary", "details"],
        "properties": {
          "id": { "type": "string" },
          "category": { "enum": ["runtime", "package", "mcp", "skill", "plugin", "ci", "system", "config"] },
          "status": { "enum": ["pass", "warning", "fail"] },
          "summary": { "type": "string" },
          "details": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "system": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "version", "line", "status"],
        "properties": {
          "tool": { "type": "string" },
          "version": { "type": "string" },
          "line": { "type": "string" },
          "status": { "enum": ["supported", "end-of-life", "scheduled-end-of-life"] },
          "ruleId": { "type": "string" },
          "deadline": { "type": "string" },
          "replacement": { "type": "string" }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "notes"],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "kind", "command"],
            "properties": {
              "tool": { "enum": ["npm", "pnpm", "yarn", "pytest", "tox", "go", "maven", "gradle", "dotnet", "configured"] },
              "kind": { "enum": ["setup", "install", "build", "test"] },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryDataUploaded", "configurationMutated"],
      "properties": {
        "repositoryDataUploaded": { "const": false },
        "configurationMutated": { "const": false }
      }
    }
  }
}
