{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velella.sh/offing/schemas/check-snippet.v1.schema.json",
  "title": "Offing snippet check v1",
  "description": "What Offing flags in one file snippet, with snippet-relative paths, lines, and replacement guidance.",
  "type": "object",
  "required": [
    "schemaVersion",
    "path",
    "findings",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "offing.check-snippet.v1"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "The repository-relative path the snippet was checked as, for example Dockerfile."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ruleId",
          "detector",
          "title",
          "summary",
          "severity",
          "location",
          "sources",
          "code",
          "replacement",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/id"
          },
          "ruleId": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/ruleId"
          },
          "detector": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/detector"
          },
          "title": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/title"
          },
          "summary": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/summary"
          },
          "severity": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/severity"
          },
          "confidence": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/confidence"
          },
          "location": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/location"
          },
          "replacement": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependencyPath": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/dependencyPath"
          },
          "deadline": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/deadline"
          },
          "sources": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/sources"
          },
          "advisoryIds": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/advisoryIds"
          },
          "usages": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/usages"
          },
          "impact": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/impact"
          },
          "migration": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/migration"
          },
          "code": {
            "type": "string",
            "maxLength": 240
          },
          "source": {
            "$ref": "scan.v1.schema.json#/properties/findings/items/properties/sources/items"
          }
        }
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence a person or an agent can show as is."
    },
    "more": {
      "type": "object",
      "required": ["truncated", "hint", "omitted", "estimatedTokens"],
      "additionalProperties": false,
      "properties": {
        "truncated": { "const": true, "description": "Always true: the answer was cut to fit the size cap." },
        "hint": { "type": "string", "minLength": 1, "description": "How to read what was left out." },
        "omitted": {
          "type": "array",
          "description": "One entry per array that lost elements. A path with [] sums every array at that position, including those inside elements that were left out.",
          "items": {
            "type": "object",
            "required": ["path", "shown", "total"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*$",
                "description": "Where the array sits, such as findings or findings[].usages."
              },
              "shown": { "type": "integer", "minimum": 0, "description": "Elements in the answer as returned." },
              "total": { "type": "integer", "minimum": 1, "description": "Elements in the full answer." }
            }
          }
        },
        "clipped": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path of every text that was shortened; it ends with a truncation marker."
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the answer as returned: three characters of JSON text count as one token."
        }
      }
    }
  }
}
