{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velella-sh/offing/schemas/plan.v1.schema.json",
  "title": "Offing migration plan v1",
  "$comment": "Every item id belongs to exactly one wave. JSON Schema cannot compare members across arrays, so tests/plan-schema.test.ts rejects duplicates together with this schema.",
  "type": "object",
  "required": ["schema", "waves", "items", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "offing.plan.v1" },
    "waves": {
      "type": "array",
      "items": { "$ref": "#/$defs/wave" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "more": {
      "type": "object",
      "required": ["truncated", "hint", "omitted", "estimatedTokens"],
      "additionalProperties": false,
      "properties": {
        "truncated": { "const": true, "description": "Always true: the answer was cut to fit the size cap." },
        "hint": { "type": "string", "minLength": 1, "description": "How to read what was left out." },
        "omitted": {
          "type": "array",
          "description": "One entry per array that lost elements. A path with [] sums every array at that position, including those inside elements that were left out.",
          "items": {
            "type": "object",
            "required": ["path", "shown", "total"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?(\\.[A-Za-z_$][A-Za-z0-9_$]*(\\[\\])?)*$",
                "description": "Where the array sits, such as findings or findings[].usages."
              },
              "shown": { "type": "integer", "minimum": 0, "description": "Elements in the answer as returned." },
              "total": { "type": "integer", "minimum": 1, "description": "Elements in the full answer." }
            }
          }
        },
        "clipped": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Path of every text that was shortened; it ends with a truncation marker."
        },
        "estimatedTokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the answer as returned: three characters of JSON text count as one token."
        }
      }
    }
  },
  "$defs": {
    "wave": {
      "type": "object",
      "required": ["index", "itemIds"],
      "additionalProperties": false,
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "findingId", "title", "severity", "touches", "branch", "wave"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "findingId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "touches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "branch": { "type": "string", "minLength": 1 },
        "wave": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": ["items", "waves", "bySeverity"],
      "additionalProperties": false,
      "properties": {
        "items": { "type": "integer", "minimum": 0 },
        "waves": { "type": "integer", "minimum": 0 },
        "bySeverity": {
          "type": "object",
          "required": ["info", "low", "medium", "high", "critical"],
          "additionalProperties": false,
          "properties": {
            "info": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "critical": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "id": { "type": "string", "minLength": 1 },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!\\.$)(?!/)(?!\\./)(?!^[A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!.*/$).+$"
    }
  }
}
