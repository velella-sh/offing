jobs:
  ci:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node: ['18', '20', '24']
        python: ['3.9', '3.10', '3.11']
    steps:
      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
      - uses: actions/setup-python@v4
        with:
          python-version: ${{ matrix.python }}
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - uses: actions/setup-python@v4
        with:
          python-version: "3.9"
