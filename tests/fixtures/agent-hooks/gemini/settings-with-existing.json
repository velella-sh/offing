{
  "theme": "Default",
  "mcpServers": {
    "offing": {
      "command": "npx",
      "args": ["--yes", "@velella/offing@0.1.0", "mcp"]
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [{ "name": "shell-policy", "type": "command", "command": "echo checked", "timeout": 5000 }]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [{ "name": "command-log", "type": "command", "command": "echo done", "timeout": 5000 }]
      }
    ]
  }
}
