{
  "ci": {
    "collect": {
      "staticDistDir": "./_serve",
      "url": [
        "http://localhost/offing/",
        "http://localhost/offing/rules/nodejs.runtime.eol-18.html",
        "http://localhost/offing/VALIDATION/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "resource-summary:document:size": ["error", { "maxNumericValue": 40960 }],
        "total-byte-weight": ["error", { "maxNumericValue": 163840 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }]
      }
    }
  }
}
