{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "fixes", "charts", "agent"],
  "properties": {
    "schemaVersion": {
      "const": "offing.fix-evals-page.v1"
    },
    "run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "selected",
          "measured",
          "excluded",
          "revision",
          "ebb",
          "evidence",
          "failureLinks",
          "agentLinks"
        ],
        "properties": {
          "id": {
            "const": "fix-evals"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "selected": {
            "type": "integer",
            "minimum": 0
          },
          "measured": {
            "type": "integer",
            "minimum": 0
          },
          "excluded": {
            "type": "integer",
            "minimum": 0
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "ebb": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "failureLinks": {
            "type": "string"
          },
          "agentLinks": {
            "type": "string"
          }
        }
      },
      "maxItems": 1
    },
    "fixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cases",
          "status",
          "deterministic",
          "applied",
          "resolved",
          "noNewFinding",
          "idempotent",
          "buildKeptGreen",
          "testsKeptGreen"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "cases": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": ["measured", "too few cases"]
          },
          "deterministic": {
            "type": "string"
          },
          "applied": {
            "type": "string"
          },
          "resolved": {
            "type": "string"
          },
          "noNewFinding": {
            "type": "string"
          },
          "idempotent": {
            "type": "string"
          },
          "buildKeptGreen": {
            "type": "string"
          },
          "testsKeptGreen": {
            "type": "string"
          }
        }
      }
    },
    "charts": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "percent"],
        "properties": {
          "label": {
            "type": "string"
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "agent": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "date", "profile", "agent", "arm", "static", "project", "both", "source"],
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "profile": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "arm": {
            "enum": ["Bare prompt", "Migration packet"]
          },
          "static": {
            "type": "string",
            "pattern": "^\\d+/\\d+$"
          },
          "project": {
            "type": "string",
            "pattern": "^(\\d+/\\d+|not run)$"
          },
          "both": {
            "type": "string",
            "pattern": "^(\\d+/\\d+|not run)$"
          },
          "source": {
            "type": "string",
            "pattern": "^https://github\\.com/"
          }
        }
      }
    }
  }
}
