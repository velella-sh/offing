/cmake-module/find-gdal?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"find_package(GDAL CONFIG) using GDAL's upstream CMake package\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How do I check pkg:generic/cmake-module/find-gdal?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Run offing check pkg:generic/cmake-module/find-gdal.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>","position":{"start":{"line":79,"column":1,"offset":3039},"end":{"line":154,"column":10,"offset":5892}}}],"position":{"start":{"line":12,"column":1,"offset":0},"end":{"line":155,"column":1,"offset":5893}}}}
