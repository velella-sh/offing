ode 26 or later\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How do I check pkg:generic/xcode?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Run offing check pkg:generic/xcode.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>","position":{"start":{"line":81,"column":1,"offset":2951},"end":{"line":151,"column":10,"offset":5641}}}],"position":{"start":{"line":12,"column":1,"offset":0},"end":{"line":152,"column":1,"offset":5642}}}}
