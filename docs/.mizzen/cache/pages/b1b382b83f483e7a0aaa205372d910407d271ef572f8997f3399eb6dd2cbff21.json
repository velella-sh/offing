{"format":1,"engine":"0.1.0","key":"b1b382b83f483e7a0aaa205372d910407d271ef572f8997f3399eb6dd2cbff21","tree":{"type":"root","children":[{"type":"heading","depth":1,"children":[{"type":"text","value":"Newsletters","position":{"start":{"line":5,"column":3,"offset":3},"end":{"line":5,"column":14,"offset":14}}}],"position":{"start":{"line":5,"column":1,"offset":1},"end":{"line":5,"column":14,"offset":14}},"data":{"id":"newsletters","hProperties":{"id":"newsletters"}}},{"type":"paragraph","children":[{"type":"text","value":"Three lengths for editors, plus subject lines and a one-line listing entry.\nSend the shortest version that fits the newsletter's format, and include the\nlink to the repository rather than an attachment. Check the newsletter's\npublished submission address and rules first.","position":{"start":{"line":7,"column":1,"offset":16},"end":{"line":10,"column":46,"offset":287}}}],"position":{"start":{"line":7,"column":1,"offset":16},"end":{"line":10,"column":46,"offset":287}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Subject lines","position":{"start":{"line":12,"column":4,"offset":292},"end":{"line":12,"column":17,"offset":305}}}],"position":{"start":{"line":12,"column":1,"offset":289},"end":{"line":12,"column":17,"offset":305}},"data":{"id":"subject-lines","hProperties":{"id":"subject-lines"}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Offing: find what is about to stop working","position":{"start":{"line":14,"column":3,"offset":309},"end":{"line":14,"column":47,"offset":353}}}],"position":{"start":{"line":14,"column":3,"offset":309},"end":{"line":14,"column":47,"offset":353}}}],"position":{"start":{"line":14,"column":1,"offset":307},"end":{"line":14,"column":47,"offset":353}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Offline lifecycle checks for runtimes, packages, and Actions","position":{"start":{"line":15,"column":3,"offset":356},"end":{"line":15,"column":65,"offset":418}}}],"position":{"start":{"line":15,"column":3,"offset":356},"end":{"line":15,"column":65,"offset":418}}}],"position":{"start":{"line":15,"column":1,"offset":354},"end":{"line":15,"column":65,"offset":418}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"Know what breaks next, before the upgrade","position":{"start":{"line":16,"column":3,"offset":421},"end":{"line":16,"column":46,"offset":464}}}],"position":{"start":{"line":16,"column":3,"offset":421},"end":{"line":16,"column":46,"offset":464}}}],"position":{"start":{"line":16,"column":1,"offset":419},"end":{"line":16,"column":46,"offset":464}}}],"position":{"start":{"line":14,"column":1,"offset":307},"end":{"line":16,"column":46,"offset":464}}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Preheader:","position":{"start":{"line":18,"column":3,"offset":468},"end":{"line":18,"column":13,"offset":478}}}],"position":{"start":{"line":18,"column":1,"offset":466},"end":{"line":18,"column":15,"offset":480}}},{"type":"text","value":" Local-first deprecation intelligence for repositories and CI.","position":{"start":{"line":18,"column":15,"offset":480},"end":{"line":18,"column":77,"offset":542}}}],"position":{"start":{"line":18,"column":1,"offset":466},"end":{"line":18,"column":77,"offset":542}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"50-word blurb","position":{"start":{"line":20,"column":4,"offset":547},"end":{"line":20,"column":17,"offset":560}}}],"position":{"start":{"line":20,"column":1,"offset":544},"end":{"line":20,"column":17,"offset":560}},"data":{"id":"50-word-blurb","hProperties":{"id":"50-word-blurb"}}},{"type":"code","lang":"text","meta":null,"value":"Offing is a local-first CLI that finds end-of-life runtimes, deprecated\npackages, and retired GitHub Actions at the exact file and line. Each finding\nincludes severity, a replacement, and an authoritative source. Scans run\noffline, need no account, and never execute repository code. Try it with\n`npx @velella/offing scan .`","position":{"start":{"line":22,"column":1,"offset":562},"end":{"line":28,"column":4,"offset":898}},"data":{"code":{"raw":"","title":null,"highlight":[],"ins":[],"del":[],"diff":false,"showLineNumbers":false}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"100-word blurb","position":{"start":{"line":30,"column":4,"offset":903},"end":{"line":30,"column":18,"offset":917}}}],"position":{"start":{"line":30,"column":1,"offset":900},"end":{"line":30,"column":18,"offset":917}},"data":{"id":"100-word-blurb","hProperties":{"id":"100-word-blurb"}}},{"type":"code","lang":"text","meta":null,"value":"Offing is a local-first CLI that finds end-of-life runtimes, deprecated\npackages, and retired GitHub Actions in a repository, and shows the exact file\nand line for each one. Every finding carries severity, a replacement, an\nauthoritative source, and migration context for a human or coding agent. Scans\nmake no network requests, need no account, and never execute repository code.\n\nIt runs as a CLI, a local MCP server, a GitHub Action, and an Agent Skill. A\nbaseline accepts known findings with an owner, reason, and expiry, so CI gates\nnew findings rather than accepted ones. Start with\n`npx @velella/offing scan .`","position":{"start":{"line":32,"column":1,"offset":919},"end":{"line":43,"column":4,"offset":1548}},"data":{"code":{"raw":"","title":null,"highlight":[],"ins":[],"del":[],"diff":false,"showLineNumbers":false}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"200-word blurb","position":{"start":{"line":45,"column":4,"offset":1553},"end":{"line":45,"column":18,"offset":1567}}}],"position":{"start":{"line":45,"column":1,"offset":1550},"end":{"line":45,"column":18,"offset":1567}},"data":{"id":"200-word-blurb","hProperties":{"id":"200-word-blurb"}}},{"type":"code","lang":"text","meta":null,"value":"Offing is a local-first CLI that finds end-of-life runtimes, deprecated\npackages, and retired GitHub Actions in a repository, and shows the exact file\nand line for each one.\n\nUpdate tools answer whether a newer version exists. Offing answers a\ndifferent question: what in this repository is about to stop working, where is\nit used, and what evidence says so? Each finding carries severity, a\nreplacement, the authoritative source behind the claim, and migration context\nfor a human or coding agent. It suggests verification commands and never runs\nthem.\n\nScans read manifests, lockfiles, workflow files, and runtime pins. They make no\nnetwork requests, need no account, and never execute repository code. The same\nfindings feed the CLI, a local MCP server, a GitHub Action, and an Agent Skill.\n\nCI integrations include annotations, a job summary, an optional pull request\ncomment, optional SARIF for code scanning, and a severity gate. A baseline\naccepts existing findings with an owner, reason, and expiry, so the gate fires\non new findings, not the ones you accepted.\n\nCoverage is deliberately uneven and documented; Node.js, npm, Python, and GitHub\nActions are Supported, and the other listed detectors are Beta or Experimental.\nA package with no rule reports `no-data`, not safe. Offing is not a\nvulnerability scanner and does not replace Renovate or Dependabot.\n\nTry it with `npx @velella/offing scan .` on Node.js 22 or newer.","position":{"start":{"line":47,"column":1,"offset":1569},"end":{"line":74,"column":4,"offset":3013}},"data":{"code":{"raw":"","title":null,"highlight":[],"ins":[],"del":[],"diff":false,"showLineNumbers":false}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"One-line listing entry","position":{"start":{"line":76,"column":4,"offset":3018},"end":{"line":76,"column":26,"offset":3040}}}],"position":{"start":{"line":76,"column":1,"offset":3015},"end":{"line":76,"column":26,"offset":3040}},"data":{"id":"one-line-listing-entry","hProperties":{"id":"one-line-listing-entry"}}},{"type":"code","lang":"text","meta":null,"value":"Offing - local-first deprecation intelligence for software repositories: end-of-life runtimes, deprecated packages, and retired GitHub Actions with exact locations and sources. https://github.com/velella-sh/offing","position":{"start":{"line":78,"column":1,"offset":3042},"end":{"line":80,"column":4,"offset":3267}},"data":{"code":{"raw":"","title":null,"highlight":[],"ins":[],"del":[],"diff":false,"showLineNumbers":false}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Media","position":{"start":{"line":82,"column":4,"offset":3272},"end":{"line":82,"column":9,"offset":3277}}}],"position":{"start":{"line":82,"column":1,"offset":3269},"end":{"line":82,"column":9,"offset":3277}},"data":{"id":"media","hProperties":{"id":"media"}}},{"type":"paragraph","children":[{"type":"text","value":"Offer one image, not a gallery. All paths are relative to this file and point at\nexisting documentation assets.","position":{"start":{"line":84,"column":1,"offset":3279},"end":{"line":85,"column":31,"offset":3390}}}],"position":{"start":{"line":84,"column":1,"offset":3279},"end":{"line":85,"column":31,"offset":3390}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"HTML report, best for a general developer audience:\n","position":{"start":{"line":87,"column":3,"offset":3394},"end":{"line":88,"column":1,"offset":3446}}},{"type":"inlineCode","value":"../assets/screenshots/html-report.webp","position":{"start":{"line":88,"column":3,"offset":3448},"end":{"line":88,"column":43,"offset":3488}}}],"position":{"start":{"line":87,"column":3,"offset":3394},"end":{"line":88,"column":43,"offset":3488}}}],"position":{