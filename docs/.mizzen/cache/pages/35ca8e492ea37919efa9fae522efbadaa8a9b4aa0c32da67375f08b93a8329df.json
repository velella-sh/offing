{"format":1,"engine":"0.1.0","key":"35ca8e492ea37919efa9fae522efbadaa8a9b4aa0c32da67375f08b93a8329df","tree":{"type":"root","children":[{"type":"heading","depth":1,"children":[{"type":"text","value":"Migration plans","position":{"start":{"line":5,"column":3,"offset":3},"end":{"line":5,"column":18,"offset":18}}}],"position":{"start":{"line":5,"column":1,"offset":1},"end":{"line":5,"column":18,"offset":18}},"data":{"id":"migration-plans","hProperties":{"id":"migration-plans"}}},{"type":"paragraph","children":[{"type":"inlineCode","value":"offing plan","position":{"start":{"line":7,"column":1,"offset":20},"end":{"line":7,"column":14,"offset":33}}},{"type":"text","value":" turns a scan into waves of independent migration tasks. Each task names the files it is expected to edit (its touch set), a suggested branch, and the finding to migrate. Tasks in the same wave never share a touched path, so a host can start them as parallel agent sessions without two agents editing the same file.","position":{"start":{"line":7,"column":14,"offset":33},"end":{"line":7,"column":329,"offset":348}}}],"position":{"start":{"line":7,"column":1,"offset":20},"end":{"line":7,"column":329,"offset":348}}},{"type":"code","lang":"bash","meta":null,"value":"# From a clone of Offing:\nnpm ci\nnpm run build\ndemo=\"$(node dist/tools/examples.js demo)\"\nnpx @velella/offing plan \"$demo\"\nnpx @velella/offing plan \"$demo\" --json\nnpx @velella/offing plan \"$demo\" --wave 0","position":{"start":{"line":9,"column":1,"offset":350},"end":{"line":17,"column":4,"offset":566}},"data":{"code":{"raw":"","title":null,"highlight":[],"ins":[],"del":[],"diff":false,"showLineNumbers":false}}},{"type":"paragraph","children":[{"type":"text","value":"The JSON form is the versioned ","position":{"start":{"line":19,"column":1,"offset":568},"end":{"line":19,"column":32,"offset":599}}},{"type":"inlineCode","value":"offing.plan.v1","position":{"start":{"line":19,"column":32,"offset":599},"end":{"line":19,"column":48,"offs