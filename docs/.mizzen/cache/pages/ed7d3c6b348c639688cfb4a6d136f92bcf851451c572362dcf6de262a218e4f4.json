rted Terraform cloud functions","position":{"start":{"line":68,"column":18,"offset":5089},"end":{"line":68,"column":84,"offset":5155}}}],"position":{"start":{"line":68,"column":16,"offset":5087},"end":{"line":68,"column":86,"offset":5157}}}],"position":{"start":{"line":68,"column":1,"offset":5072},"end":{"line":68,"column":86,"offset":5157}}},{"type":"tableRow","children":[{"type":"tableCell","children":[{"type":"inlineCode","value":"shell","position":{"start":{"line":69,"column":3,"offset":5160},"end":{"line":69,"column":10,"offset":5167}}}],"position":{"start":{"line":69,"column":1,"offset":5158},"end":{"line":69,"column":11,"offset":5168}}},{"type":"tableCell","children":[{"type":"text","value":"PowerShell scripts, modules, and CI containers","position":{"start":{"line":69,"column":13,"offset":5170},"end":{"line":69,"column":59,"offset":5216}}}],"position":{"start":{"line":69,"column":11,"offset":5168},"end":{"line":69,"column":61,"offset":5218}}}],"position":{"start":{"line":69,"column":1,"offset":5158},"end":{"line":69,"column":61,"offset":5218}}},{"type":"tableRow","children":[{"type":"tableCell","children":[{"type":"inlineCode","value":"swift","position":{"start":{"line":70,"column":3,"offset":5221},"end":{"line":70,"column":10,"offset":5228}}}],"position":{"start":{"line":70,"column":1,"offset":5219},"end":{"line":70,"column":11,"offset":5229}}},{"type":"tableCell","children":[{"type":"text","value":"Swift packages and Xcode applications; project and toolchain declarations","position":{"start":{"line":70,"column":13,"offset":5231},"end":{"line":70,"column":86,"offset":5304}}}],"position":{"start":{"line":70,"column":11,"offset":5229},"end":{"line":70,"column":88,"offset":5306}}}],"position":{"start":{"line":70,"column":1,"offset":5219},"end":{"line":70,"column":88,"offset":5306}}},{"type":"tableRow","children":[{"type":"tableCell","children":[{"type":"inlineCode","value":"terraform","position":{"start":{"line":71,"column":3,"offset":5309},"end":{"line":71,"column":14,"offset":5320}}}],"position":{"start":{"line":71,"column":1,"offset":5307},"end":{"line":71,"column":15,"offset":5321}}},{"type":"tableCell","children":[{"type":"text","value":"Modules and deployments; different supported providers","position":{"start":{"line":71,"column":17,"offset":5323},"end":{"line":71,"column":71,"offset":5377}}}],"position":{"start":{"line":71,"column":15,"offset":5321},"end":{"line":71,"column":73,"offset":5379}}}],"position":{"start":{"line":71,"column":1,"offset":5307},"end":{"line":71,"column":73,"offset":5379}}}],"position":{"start":{"line":47,"column":1,"offset":3581},"end":{"line":71,"column":73,"offset":5379}}},{"type":"paragraph","children":[{"type":"text","value":"For each bucket, declare strata before selection using supported input forms or stack families from the table,\nplus small (at most 5,000 KB) and medium (5,001–50,000 KB) repositories. Walk nonempty strata round-robin in a\nrecorded order; within each, sort by lowercase ","position":{"start":{"line":73,"column":1,"offset":5381},"end":{"line":75,"column":48,"offset":5650}}},{"type":"inlineCode","value":"owner/name","position":{"start":{"line":75,"column":48,"offset":5650},"end":{"line":75,"column":60,"offset":5662}}},{"type":"text","value":". Deduplicate overlapping strata. Search for input\nfilenames or ecosystem structure, not deprecated versions or known findings. Record application/library and\nmaintainer diversity where applicable; publish empty strata and search limits rather than inventing coverage.","position":{"start":{"line":75,"column":60,"offset":5662},"end":{"line":77,"column":110,"offset":5930}}}],"position":{"start":{"line":73,"column":1,"offset":5381},"end":{"line":77,"column":110,"offset":5930}}},{"type":"paragraph","children":[{"type":"text","value":"Never choose the next repository by its score or stop a batch because enough positive or zero-finding examples\nhave appeared. Version-specific searches and known migrations are targeted supplements, labeled ","position":{"start":{"line":79,"column":1,"offset":5932},"end":{"line":80,"column":97,"offset":6139}}},{"type":"inlineCode","value":"targeted","position":{"start":{"line":80,"column":97,"offset":6139},"end":{"line":80,"column":107,"offset":6149}}},{"type":"text","value":" and\nreported separately; they cannot replace the blind sample. Existing blind labels retain their historical\nmeaning under decision 0013, even when their older selection rules differ from this record.","position":{"start":{"line":80,"column":107,"offset":6149},"end":{"line":82,"column":92,"offset":6350}}}],"position":{"start":{"line":79,"column":1,"offset":5932},"end":{"line":82,"column":92,"offset":6350}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"3. Interpret 200 as reviewed projects per bucket","position":{"start":{"line":84,"column":5,"offset":6356},"end":{"line":84,"column":53,"offset":6404}}}],"position":{"start":{"line":84,"column":1,"offset":6352},"end":{"line":84,"column":53,"offset":6404}},"data":{"id":"3-interpret-200-as-reviewed-projects-per-bucket","hProperties":{"id":"3-interpret-200-as-reviewed-projects-per-bucket"}}},{"type":"paragraph","children":[{"type":"text","value":"The growth target is ","position":{"start":{"line":86,"column":1,"offset":6406},"end":{"line":86,"column":22,"offset":6427}}},{"type":"strong","children":[{"type":"text","value":"200 distinct eligible upstream repositories in each of the 23 buckets","position":{"start":{"line":86,"column":24,"offset":6429},"end":{"line":86,"column":93,"offset":6498}}}],"position":{"start":{"line":86,"column":22,"offset":6427},"end":{"line":86,"column":95,"offset":6500}}},{"type":"text","value":": 4,600 bucket\nmemberships, not 200 overall, 200 findings, or 200 successful scans. A project belongs to one primary bucket\nchosen from its input evidence before scanning; multiple commits, monorepo packages, or incidental findings\nfrom other detectors do not increase the count. All detectors still scan the selected tree, and every judged\nfinding is labeled. Report cross-ecosystem detector evidence separately from bucket membership.","position":{"start":{"line":86,"column":95,"offset":6500},"end":{"line":90,"column":96,"offset":6936}}}],"position":{"start":{"line":86,"column":1,"offset":6406},"end":{"line":90,"column":96,"offset":6936}}},{"type":"paragraph","children":[{"type":"text","value":"Count an entry toward 200 only after its pin, eligibility, selection provenance, and ground truth have been\nreviewed, including a review supporting an empty expected list. Retained historical entries count only where\ntheir recorded evidence establishes eligibility at their selection date; missing evidence is not grandfathered\ninto the new total. Publish blind and targeted counts alongside the total, and keep at least two thirds of the\ncounted repositories blind, matching the stable selection floor in decision 0013. Reaching 200 alone grants\nneither stable maturity nor a claim of representative accuracy; the other maturity and independent-validation\nrequirements remain in force, and held-out repositories stay separate from this growth count.","position":{"start":{"line":92,"column":1,"offset":6938},"end":{"line":98,"column":94,"offset":7688}}}],"position":{"start":{"line":92,"column":1,"offset":6938},"end":{"line":98,"column":94,"offset":7688}}},{"type":"paragraph","children":[{"type":"strong","children":[{"type":"text","value":"Poor precision, poor recall, unexpected findings, zero findings, parser failures, and slow scans are never\nreasons to remove or replace a selected repository.","position":{"start":{"line":100,"column":3,"offset":7692},"end":{"line":101,"column":52,"offset":7850}}}],"position":{"start":{"line":100,"column":1,"offset":7690},"end":{"line":101,"column":54,"offset":7852}}},{"type":"text","value":" Keep failures visible and fix Offing or track the gap.\nA pending review or failed scan is reported explicitly, not converted into a clean result. Correct wrong labels\nonly with independent evidence and a reviewed history of the correction. Removal requires an objective reason\nsuch as a duplicate upstream, lost access, or a confirmed licensing problem, recorded in review with the old\npin and reason retained; its replacement follows the same precommitted selection order.","position":{"start":{"line":101,"column":54,"offset":7852},"end":{"line":105,"column":88,"offset":8326}}}],"position":{"start":{"line":100,"column":1,"offset":7690},"end":{"line":105,"column":88,"offset":8326}}},{"type":"heading","depth":3,"children":[{"type":"text","value":"4. Publish an honest shortfall","position":{"start":{"line":107,"column":5,"offset":8332},"end":{"line":107,"column":35,"offset":8362}}}],"position":{"start":{"line":107,"column":1,"offset":8328},"end":{"line":107,"column":35,"offset":8362}},"data":{"id":"4-publish-an-honest-shortfall","hProperties":{"id":"4-publish-an-honest-shortfall"}}},{"type":"paragraph","children":[{"type":"text","value":"If the recorded searches and strata cannot supply 200 eligible, reviewed repositories, publish the actual\ncount as ","position":{"start":{"line":109,"column":1,"offset":8364},"end":{"line":110,"column":10,"offset":8479}}},{"type":"inlineCode","value":"N/200","position":{"start":{"line":110,"column":10,"offset":8479},"end":{"line":110,"column":17,"offset":8486}}},{"type":"text","value":", the blind/targeted split, pending reviews and fetch failures, empty strata, discovery date,\nqueries and search limits, and skip reasons. A capped search is evidence of a limited search, not proof that\nthe ecosystem has no more repositories. State which limitation prevents further growth.","position":{"start":{"line":110,"column":17,"offset":8486},"end":{"line":112,"column":88,"offset":8776}}}],"position":{"start":{"line":109,"column":1,"offset":8364},"end":{"line":112,"column":88,"offset":8776}}},{"type":"paragraph","children":[{"type":"text","value":"Do not pad the count with forks, duplicate commits, fixtures, generated toy projects, other ecosystems, or\nunreviewed labels; do not relax activity, size, licensing, or blind-selection rules just to hit 200. A maintainer\nmay accept a documented shortfall for the release while the target remains unmet. Any different target or\neligibility exception needs a separate reviewed decision before new selection, with its effect on comparability\nexplained. Schedule a follow-up discovery batch when the candidate pool or tooling improves.","position":{"start":{"line":114,"column":1,"offset":8778},"end":{"line":118,"column":93,"offset":9309}}}],"position":{"start":{"line":114,"column":1,"offset":8778},"end":{"line":118,"column":93,"offset":9309}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Consequences","position":{"start":{"line":120,"column":4,"offset":9314},"end":{"line":120,"column":16,"offset":9326}}}],"position":{"start":{"line":120,"column":1,"offset":9311},"end":{"line":120,"column":16,"offset":9326}},"data":{"id":"consequences","hProperties":{"id":"consequences"}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Growth is reproducible from saved selection records and pins; new selection and labeling tooling follows this\npolicy in the remaining tasks of #1993. This record adds no runtime behavior, network path, or dependency.","position":{"start":{"line":122,"column":3,"offset":9330},"end":{"line":123,"column":109,"offset":9548}}}],"position":{"start":{"line":122,"column":3,"offset":9330},"end":{"line":123,"column":109,"offset":9548}}}],"position":{"start":{"line":122,"column":1,"offset":9328},"end":{"line":123,"column":109,"offset":9548}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Blind selection remains distinct from independent ground truth. A regression corpus labeled after seeing\nOffing's output cannot establish generalization; preserve the separate held-out process in\n","position":{"start":{"line":124,"column":3,"offset":9551},"end":{"line":126,"column":1,"offset":9749}}},{"type":"link","title":null,"url":"../validation/corpus.md#the-held-out-set","children":[{"type":"text","value":"Validation corpus","position":{"start":{"line":126,"column":4,"offset":9752},"end":{"line":126,"column":21,"offset":9769}}}],"position":{"start":{"line":126,"column":3,"offset":9751},"end":{"line":126,"column":64,"offset":9812}}},{"type":"text","value":".","position":{"start":{"line":126,"column":64,"offset":9812},"end":{"line":126,"column":65,"offset":9813}}}],"position":{"start":{"line":124,"column":3,"offset":9551},"end":{"line":126,"column":65,"offset":9813}}}],"position":{"start":{"line":124,"column":1,"offset":9549},"end":{"line":126,"column":65,"offset":9813}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Maintainer merge of the pull request for #2116 records acceptance of this policy. Automated checks establish\nrepository health; they do not supply maintainer acceptance or prove that the corpus already meets it.","position":{"start":{"line":127,"column":3,"offset":9816},"end":{"line":128,"column":105,"offset":10029}}}],"position":{"start":{"line":127,"column":3,"offset":9816},"end":{"line":128,"column":105,"offset":10029}}}],"position":{"start":{"line":127,"column":1,"offset":9814},"end":{"line":128,"column":105,"offset":10029}}}],"position":{"start":{"line":122,"column":1,"offset":9328},"end":{"line":128,"column":105,"offset":10029}}}],"position":{"start":{"line":1,"column":1,"offset":0},"end":{"line":129,"column":1,"offset":10030}}}}
