ility-before-scanning"}}},{"type":"paragraph","children":[{"type":"text","value":"For each batch, commit the discovery date (UTC), queries, filters, ordered candidate list, selected repositories,\nskip reasons, and default-branch commit SHAs before running Offing on the selections. Preserve the search\nsnapshot because live rankings change. Apply these rules equally to all ecosystems:","position":{"start":{"line":19,"column":1,"offset":840},"end":{"line":21,"column":84,"offset":1143}}}],"position":{"start":{"line":19,"column":1,"offset":840},"end":{"line":21,"column":84,"offset":1143}}},{"type":"table","align":[null,null],"children":[{"type":"tableRow","children":[{"type":"tableCell","children":[{"type":"text","value":"Criterion","position":{"start":{"line":23,"column":3,"offset":1147},"end":{"line":23,"column":12,"offset":1156}}}],"position":{"start":{"line":23,"column":1,"offset":1145},"end":{"line":23,"column":13,"offset":1157}}},{"type":"tableCell","children":[{"type":"text","value":"Rule for new blind selections","position":{"start":{"line":23,"column":15,"offset":1159},"end":{"line":23,"column":44,"offset":1188}}}],"position":{"start":{"line":23,"column":13,"offset":1157},"end":{"line":23,"column":46,"offset":1190}}}],"position":{"start":{"line":23,"column":1,"offset":1145},"end":{"line":23,"column":46,"offset":1190}}},{"type":"tableRow","children":[{"type":"tableCell","children":[{"type":"text","value":"Public and independent","position":{"start":{"line":25,"column":3,"offset":1207},"end":{"line":25,"column":25,"offset":1229}}}],"position":{"start":{"line":25,"column":1,"offset":1205},"end":{"line":25,"column":26,"offset":1230}}},{"type":"tableCell","children":[{"type":"text","value":"Public, not archived, not a fork or mirror. Count one upstream project once; renamed repositories and duplicate pins are not new projects. No minimum stars, downloads, or organization membership.","position":{"start":{"line":25,"column":28,"offset":1232},"end":{"line":25,"column