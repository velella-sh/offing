e":47,"column":93,"offset":5403},"end":{"line":47,"column":133,"offset":5443}},"data":{"hProperties":{"rel":"external"}}},{"type":"text","value":" (","position":{"start":{"line":47,"column":133,"offset":5443},"end":{"line":47,"column":135,"offset":5445}}},{"type":"inlineCode","value":"@velella/ebb","position":{"start":{"line":47,"column":135,"offset":5445},"end":{"line":47,"column":149,"offset":5459}}},{"type":"text","value":"), a separate package. It is a dependency, not a layer: the domain and the core import it, and nothing in Ebb imports Offing.","position":{"start":{"line":47,"column":149,"offset":5459},"end":{"line":47,"column":274,"offset":5584}}}],"position":{"start":{"line":47,"column":1,"offset":5311},"end":{"line":47,"column":274,"offset":5584}}},{"type":"paragraph","children":[{"type":"text","value":"Rules that follow from the table:","position":{"start":{"line":49,"column":1,"offset":5586},"end":{"line":49,"column":34,"offset":5619}}}],"position":{"start":{"line":49,"column":1,"offset":5586},"end":{"line":49,"column":34,"offset":5619}}},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"The core never imports detectors. Built-in detectors reach the engine only through ","position":{"start":{"line":51,"column":3,"offset":5623},"end":{"line":51,"column":86,"offset":5706}}},{"type":"link","title":null,"url":"../src/scan-builtins.ts","children":[{"type":"text","value":"scan-builtins.ts","position":{"start":{"line":51,"column":87,"offset":5707},"end":{"line":51,"column":103,"offset":5723}}}],"position":{"start":{"line":51,"column":86,"offset":5706},"end":{"line":51,"column":129,"offset":5749}}},{"type":"text","value":", which an adapter or service calls.","position":{"start":{"line":51,"column":129,"offset":5749},"end":{"line":51,"column":165,"offset":5785}}}],"position":{"start":{"line":51,"column":3,"offset":5623},"end":{"line":51,"column":165,"offset":5785}}}],"position":{"start":{"line":51,"column":1,"offset":5621},"end":{"line":51,"column":165,"offset":5785}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Detectors may use the shared usage matcher but may not import services, reporters, or adapters.","position":{"start":{"line":52,"column":3,"offset":5788},"end":{"line":52,"column":98,"offset":5883}}}],"position":{"start":{"line":52,"column":3,"offset":5788},"end":{"line":52,"column":98,"offset":5883}}}],"position":{"start":{"line":52,"column":1,"offset":5786},"end":{"line":52,"column":98,"offset":5883}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Nothing imports an adapter except another adapter. Logic an adapter shares belongs in a service.","position":{"start":{"line":53,"column":3,"offset":5886},"end":{"line":53,"column":99,"offset":5982}}}],"position":{"start":{"line":53,"column":3,"offset":5886},"end":{"line":53,"column":99,"offset":5982}}}],"position":{"start":{"line":53,"column":1,"offset":5884},"end":{"line":53,"column":99,"offset":5982}}},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Domain, SDK, and core are meant to do no file or network access; that rule lands with the pure-core work. Detectors and reporters never use the network.","position":{"start":{"line":54,"column":3,"offset":5985},"end":{"line":54,"column":155,"offset":6137}}}],"position":{"start":{"line":54,"column":3,"offset":5985},"end":{"line":54,"column":155,"offset":6137}}}],"position":{"start":{"line":54,"column":1,"offset":5983},"end":{"line":54,"column":155,"offset":6137}}}],"position":{"start":{"line":51,"column":1,"offset":5621},"end":{"line":54,"column":155,"offset":6137}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"How the pieces work","position":{"start":{"line":56,"column":4,"offset":6142},"end":{"line":56,"column":23,"offset":6161}}}],"position":{"start":{"line":56,"column":1,"offset":6139},"end":{"line":56,"column":23,"offset":6161}},"data":{"id":"how-the-pieces-work","hProperties":{"id":"how-the-pieces-work"}}},{"type":"paragraph","children":[{"type":"text","value":"The detector SDK is the seam between the scan engine and detectors. Its interface is deliberately small. The engine owns detector attribution, sorting, and output contracts. See ","position":{"start":{"line":58,"column":1,"offset":6163},"end":{"line":58,"column":179,"offset":6341}}},{"type":"link","title":null,"url":"DETECTORS.md","children":[{"type":"text","value":"DETECTORS.md","position":{"start":{"line":58,"column":180,"offset":6342},"end":{"line":58,"column":192,"offset":6354}}}],"position":{"start":{"line":58,"column":179,"offset":6341},"end":{"line":58,"column":207,"offset":6369}}},{"type":"text","value":" for the contract.","position":{"start":{"line":58,"column":207,"offset":6369},"end":{"line":58,"column":225,"offset":6387}}}],"position":{"start":{"line":58,"column":1,"offset":6163},"end":{"line":58,"column":225,"offset":6387}}},{"type":"paragraph","children":[{"type":"text","value":"Source usage analysis is a shared batch module below the detector seam. A detector supplies declarative, language-specific match contracts; the module owns repository traversal, import binding resolution, call matching, configuration matching, deduplication, and impact calculation, and all matched package rules share one repository pass. Findings remain valid when no usages are found, because package metadata establishes the lifecycle risk independently of source usage.","position":{"start":{"line":60,"column":1,"offset":6389},"end":{"line":60,"column":475,"offset":6863}}}],"position":{"start":{"line":60,"column":1,"offset":6389},"end":{"line":60,"column":475,"offset":6863}}},{"type":"paragraph","children":[{"type":"text","value":"JavaScript, TypeScript, and Python import and call matching use a vendored tree-sitter WebAssembly runtime under ","position":{"start":{"line":62,"column":1,"offset":6865},"end":{"line":62,"column":114,"offset":6978}}},{"type":"inlineCode","value":"src/usage/vendor/tree-sitter/","position":{"start":{"line":62,"column":114,"offset":6978},"end":{"line":62,"column":145,"offset":7009}}},{"type":"text","value":", limited to those four grammars. The WebAssembly modules are committed as base64 text with a manifest of their upstream source and SHA-256 hashes, and the loader decodes them in memory, so the repository carries no binary artifact. The package does not depend on ","position":{"start":{"line":62,"column":145,"offset":7009},"end":{"line":62,"column":409,"offset":7273}}},{"type":"inlineCode","value":"@vscode/tree-sitter-wasm","position":{"start":{"line":62,"column":409,"offset":7273},"end":{"line":62,"column":435,"offset":7299}}},{"type":"text","value":" at install time: that package ships many unused grammars, and making it optional would fall back to the regex scanner and change scan results. When the parser cannot run (file too large, over budget, or runtime load failure), the shared module falls back to the regex scanner for that file.","position":{"start":{"line":62,"column":435,"offset":7299},"end":{"line":62,"column":726,"offset":7590}}}],"position":{"start":{"line":62,"column":1,"offset":6865},"end":{"line":62,"column":726,"offset":7590}}},{"type":"paragraph","children":[{"type":"text","value":"The GitHub Action is an adapter over a single action-runner module. That module owns scanning, optional baseline comparison, severity-gate evaluation, annotation data, and report persistence behind one interface. The bundled entry point only translates environment inputs and outcomes to GitHub workflow commands; the composite wrapper uploads the already-generated report even when the gate fails.","position":{"start":{"line":64,"column":1,"offset":7592},"end":{"line":64,"column":399,"offset":7990}}}],"position":{"start":{"line":64,"column":1,"offset":7592},"end":{"line":64,"column":399,"offset":7990}}},{"type":"paragraph","children":[{"type":"text","value":"Migration context is produced by a pure module whose interface accepts a scan result and finding ID. It owns lookup, affected-file derivation, constraints, ordered steps, sources, and verification commands. The CLI and local MCP server reuse the same interface.","position":{"start":{"line":66,"column":1,"offset":7992},"end":{"line":66,"column":262,"offset":8253}}}],"position":{"start":{"line":66,"column":1,"offset":7992},"end":{"line":66,"column":262,"offset":8253}}},{"type":"paragraph","children":[{"type":"text","value":"The agent-tools module owns the complete scan-to-verification workflow behind a transport-independent interface. It remembers findings observed during one session so verification cannot mistake an arbitrary or unknown ID for a successful migration. Verification performs a fresh scan, compares the stable rule-and-path identity, and returns suggested commands without executing them. The MCP module is a thin adapter over this interface and contains no detector or migration logic. See ","position":{"start":{"line":68,"column":1,"offset":8255},"end":{"line":68,"column":487,"offset":8741}}},{"type":"link","title":null,"url":"MCP.md","children":[{"type":"text","value":"MCP.md","position":{"start":{"line":68,"column":488,"offset":8742},"end":{"line":68,"column":494,"offset":8748}}}],"position":{"start":{"line":68,"column":487,"offset":8741},"end":{"line":68,"column":503,"offset":8757}}},{"type":"text","value":".","position":{"start":{"line":68,"column":503,"offset":8757},"end":{"line":68,"column":504,"offset":8758}}}],"position":{"start":{"line":68,"column":1,"offset":8255},"end":{"line":68,"column":504,"offset":8758}}},{"type":"paragraph","children":[{"type":"text","value":"The local MCP entry point uses the official TypeScript SDK's stdio transport. It does not expose an HTTP listener, make outbound requests, or call a hosted Offing service. Repository analysis and session state stay on the user's machine.","position":{"start":{"line":70,"column":1,"offset":8760},"end":{"line":70,"column":238,"offset":8997}}}],"position":{"start":{"line":70,"column":1,"offset":8760},"end":{"line":70,"column":238,"offset":8997}}},{"type":"paragraph","children":[{"type":"text","value":"The portable Agent Skill is a thin instruction adapter over the MCP and CLI interfaces. It owns no lifecycle facts, detector behavior, migration constraints, or permission grants. Codex and Claude plugins are generated host adapters over that Skill and the same local MCP launch contract; a deterministic assembly module pins both to the root package version and rejects drift in CI. See the ","position":{"start":{"line":72,"column":1,"offset":8999},"end":{"line":72,"column":393,"offset":9391}}},{"type":"link","title":null,"url":"PLUGIN_PACKAGING.md","children":[{"type":"text","value":"plugin packaging architecture","position":{"start":{"line":72,"column":394,"offset":9392},"end":{"line":72,"column":423,"offset":9421}}}],"position":{"start":{"line":72,"column":393,"offset":9391},"end":{"line":72,"column":445,"offset":9443}}},{"type":"text","value":" and ","position":{"start":{"line":72,"column":445,"offset":9443},"end":{"line":72,"column":450,"offset":9448}}},{"type":"link","title":null,"url":"decisions/0003-shared-plugin-packaging.md","children":[{"type":"text","value":"Decision 0003","position":{"start":{"line":72,"column":451,"offset":9449},"end":{"line":72,"column":464,"offset":9462}}}],"position":{"start":{"line":72,"column":450,"offset":9448},"end":{"line":72,"column":508,"offset":9506}}},{"type":"text","value":".","position":{"start":{"line":72,"column":508,"offset":9506},"end":{"line":72,"column":509,"offset":9507}}}],"position":{"start":{"line":72,"column":1,"offset":8999},"end":{"line":72,"column":509,"offset":9507}}},{"type":"heading","depth":2,"children":[{"type":"text","value":"Trust boundar