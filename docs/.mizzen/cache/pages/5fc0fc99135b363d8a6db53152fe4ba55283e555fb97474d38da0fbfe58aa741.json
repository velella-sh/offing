.sh/offing/rules/container.host-centos.eol-8-and-older.html\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What is the lifecycle status of pkg:generic/centos?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"End of life as of 2024-06-30. Affected versions: vers:semver/\\u003c9.0.0. Source: CentOS Linux (https://www.centos.org/centos-linux/).\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What replaces pkg:generic/centos?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"CentOS Stream 9 or 10, or a distribution with a published lifecycle\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"How do I check pkg:generic/centos?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Run offing check pkg:generic/centos.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>","position":{"start":{"line":83,"column":1,"offset":3336},"end":{"line":153,"column":10,"offset":5898}}}],"position":{"start":{"line":12,"column":1,"offset":0},"end":{"line":154,"column":1,"offset":5899}}}}
