{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offing lifecycle SARIF profile v1 properties",
  "description": "The offingLifecycle object in an Offing lifecycle SARIF rule or result.",
  "type": "object",
  "required": ["severity"],
  "additionalProperties": false,
  "properties": {
    "severity": {
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "endOfLifeDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^/?#\\s]+"
    },
    "replacement": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
